<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs. "production" is what App Store / TestFlight builds require; the
	     value is validated against the provisioning profile's aps-environment.
	     Xcode development builds signed with a development profile use the APNs
	     sandbox automatically. See docs/PUSH.md. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Native Sign in with Apple (the OS Face-ID sheet). The capability is
	     already enabled on the App ID com.divvysol.app in the Developer portal;
	     fastlane match (readonly: false) regenerates the provisioning profile to
	     include it when the stored one is stale/invalid. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
