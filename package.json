{
  "name": "divvy",
  "version": "0.1.0",
  "description": "Divvy — split the bill, collect in USDC on Solana. Front the bill, generate a Solana Pay USDC link + QR per person, track who paid.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build -c web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "ts-node src/split.selftest.ts",
    "new": "ts-node src/index.ts new",
    "demo": "ts-node src/index.ts demo",
    "status": "ts-node src/index.ts status",
    "qr": "ts-node src/index.ts qr",
    "verify": "ts-node src/index.ts verify",
    "web": "ts-node src/server.ts",
    "live-devnet": "ts-node src/liveDevnet.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "@privy-io/react-auth": "^2.13.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.4",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
