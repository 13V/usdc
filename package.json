{
  "name": "divvy",
  "version": "0.1.0",
  "description": "Divvy — split the bill, collect in USDC on Solana. Front the bill, generate a Solana Pay USDC link + QR per person, track who paid.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build -c web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "ts-node src/split.selftest.ts && ts-node src/security.selftest.ts",
    "test:sec": "ts-node src/security.selftest.ts",
    "test:e2e": "node e2e/happy-path.mjs",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "new": "ts-node src/index.ts new",
    "demo": "ts-node src/index.ts demo",
    "status": "ts-node src/index.ts status",
    "qr": "ts-node src/index.ts qr",
    "verify": "ts-node src/index.ts verify",
    "web": "ts-node src/server.ts",
    "start": "node dist/src/server.js",
    "live-devnet": "ts-node src/liveDevnet.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "@privy-io/react-auth": "^2.13.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.4",
    "@supabase/supabase-js": "^2.108.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.20.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "jose": "^6.2.3",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tweetnacl": "^1.0.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jimp": "^1.6.1",
    "playwright-core": "^1.61.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "undici": "^8.5.0",
    "vite": "^5.4.11",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
