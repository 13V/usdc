# Solana cluster: "devnet" (default) or "mainnet-beta".
# NEVER point at mainnet-beta without explicit review.
CLUSTER=devnet

# Custom RPC endpoint. The public devnet faucet/RPC rate-limits airdrops (429),
# so live-devnet needs a Helius/QuickNode devnet RPC here to fund a wallet.
# e.g. https://devnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=

# The wallet that COLLECTS the money (your wallet, base58 pubkey).
# This is the Solana Pay "recipient".
COLLECTOR_WALLET=

# Optional: a funded devnet keypair (JSON array of 64 bytes) used by live-devnet
# as the payer when no airdrop is available.
PAYER_SECRET_KEY=

# Money-rails provider keys for the on-ramp ("Pay with card") and off-ramp
# ("Cash out") paths. ALL OPTIONAL — without them the app runs in card "test
# mode": the widget URLs build correctly but won't actually charge or pay out.
# MOONPAY_API_KEY is the publishable key; MOONPAY_SECRET_KEY HMAC-signs the
# MoonPay buy/sell URLs (required by MoonPay in production). Providers only
# deliver/sell REAL mainnet USDC, so going live also needs the mainnet cutover.
MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=
COINBASE_ONRAMP_APP_ID=

# Embedded-wallet (no-wallet) pay path — Privy. Get an app id from the Privy
# dashboard (https://dashboard.privy.io). These are read at BUILD time by Vite,
# so re-run `npm run build:web` after setting them.
VITE_PRIVY_APP_ID=
# Optional browser RPC for the embedded pay page (defaults to public clusterApiUrl).
VITE_RPC_URL=
# Server-side Privy. Set PRIVY_APP_ID to enable /api/auth/privy/verify (else 501).
# PRIVY_APP_SECRET is REQUIRED for security: the server links only wallets Privy
# authoritatively confirms a user owns (never the client-supplied address). Without
# the secret, Privy logins link no wallet (fails safe).
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---- Safety / ops ----------------------------------------------------------
# Optional alert webhook (Slack/Discord/any JSON). Money-path anomalies
# (signature-reuse-blocked, verify-failure spikes, fund-volume) POST here.
ALERT_WEBHOOK_URL=

# ---- Telemetry + error-rate alerting (src/telemetry.ts) --------------------
# First-party error/event store. ADMIN_TOKEN gates GET /api/telemetry/recent
# (404 when unset). SENTRY_DSN / POSTHOG_KEY are optional forwarders (no npm dep).
ADMIN_TOKEN=
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Error-rate paging (distinct from ALERT_WEBHOOK_URL above, which is money-path).
# When client `error` telemetry crosses ALERT_ERROR_THRESHOLD in a rolling 10 min
# window, ONE alert fires (60 min cooldown): a JSON POST { text } to ALERT_WEBHOOK
# (Slack/Discord/any) and, if set, a push to the founder account ALERT_PUSH_USER_ID.
# Both optional; inert without their env.
ALERT_ERROR_THRESHOLD=25
ALERT_WEBHOOK=
ALERT_PUSH_USER_ID=

# Web Push (notifications). Generate a keypair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Without these, push is disabled (the client is told so). VAPID_SUBJECT is a
# mailto: or https: contact URL. Keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@divvy.app
# Emergency escape hatch ONLY: set to 1 to make the global consumed-signature
# guard fail OPEN (credit even if the store is unreachable). Default (unset) is
# fail-closed — the safe posture for real money. Leave blank in production.
CONSUMED_SIG_FAIL_OPEN=
# Per-transaction ceiling on the fiat on/off-ramp, in cents. Default 200000 ($2,000).
RAIL_MAX_CENTS=
# Set to 1 to make the server refuse to boot on mainnet unless on/off-ramp
# provider keys are configured (part of the mainnet readiness check).
RAILS_REQUIRE_LIVE=

# ---- Native app (Capacitor deep links) -------------------------------------
# Fill these once you have an Apple Developer team + Android signing cert, then
# redeploy so the association files (/.well-known/...) return real values.
# The origin the native shell loads (used by capacitor.config.ts at build time).
CAP_SERVER_URL=
# Apple Developer Team ID (10 chars), for universal links.
APPLE_TEAM_ID=
# Android app signing cert SHA-256 fingerprint, for App Links.
ANDROID_CERT_SHA256=

# Receipt scanning — Claude vision reads the total off a receipt photo.
# Get a key at https://console.anthropic.com. Without it, the app falls back to
# manual total entry (everything else still works).
ANTHROPIC_API_KEY=

# Web server port.
PORT=3000

# ---- Supabase (hosted Postgres) -------------------------------------------
# Data backend selector: "sqlite" (default, local file) or "supabase".
DATA_BACKEND=sqlite
# Project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=
# service_role key (server-side ONLY — bypasses RLS; never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=
# Optional: full Postgres connection string (with password) for applying schema.sql
# via scripts/apply-schema.ts. Find it in Supabase → Project Settings → Database.
# e.g. postgresql://postgres:<pwd>@db.<ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=
