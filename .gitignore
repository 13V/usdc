node_modules/
dist/
.env
*.log
bills/
*.png
.DS_Store

# The embedded-wallet bundle (public/embedded/, built by build:web) IS committed
# so it deploys with the app — Railway's build only compiles the backend, and the
# Vite build tooling is in devDependencies. Rebuild + commit when the web app or
# VITE_PRIVY_APP_ID changes.

# SQLite database (and WAL/SHM sidecars).
divvy.db
divvy.db-shm
divvy.db-wal
*.db

# Landing page (deployed to GitHub Pages) — keep its assets despite *.png above.
!site/**

# App icons, store screenshots, and social/OG images — committed, served in prod.
!public/icons/**
!public/screenshots/**
# Native iOS asset catalog (app icon + splash) — committed; the generated dirs
# inside ios/ are excluded by ios/.gitignore instead.
!ios/App/App/Assets.xcassets/**
!public/apple-touch-icon.png
!public/og.png

# TikTok/Reels starter kit — ready-to-post assets ARE the deliverable; keep
# them despite *.png above (the founder posts these straight from the repo).
!marketing/tiktok-kit/assets/**
_itest.js
